// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  // "native" covers whatever OS runs `prisma generate` (e.g. local macOS
  // dev); "rhel-openssl-3.0.x" is required because Netlify's Next.js
  // Lambda runtime is Linux regardless of which machine ran the build —
  // without it, deploys built on a non-Linux machine (a local build/deploy
  // instead of Netlify's own CI) ship a Query Engine the Lambda can't load.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Family {
  id        String   @id @default(cuid())
  name      String   @default("Our Family")
  createdAt DateTime @default(now())

  users   User[]
  invites FamilyInvite[]
}

model FamilyInvite {
  id          String    @id @default(cuid())
  familyId    String
  codeHash    String    @unique // sha256 of the invite code
  role        String    @default("ADULT") // 'ADULT' | 'CHILD'
  expiresAt   DateTime
  createdById String
  usedById    String?
  usedAt      DateTime?
  createdAt   DateTime  @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String?   // legacy (NextAuth) — unused after Neon Auth migration
  neonAuthUserId String?  // links this profile row to the Neon Auth identity (unique in practice)
  masterPassword String?   // Encrypted master password for vault access
  familyId      String?
  role          String    @default("OWNER") // 'OWNER' | 'ADULT' | 'CHILD'
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  family        Family?   @relation(fields: [familyId], references: [id])
  accounts      Account[]
  sessions      Session[]
  passwords     Password[]
  documents     Document[]
  trustedContacts TrustedContact[]
  emergencyAccesses EmergencyAccess[]
  auditLogs     AuditLog[]

  @@index([neonAuthUserId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Password {
  id          String   @id @default(cuid())
  userId      String   // creator ("added by")
  familyId    String?
  category    String   // 'bank', 'email', 'phone', 'laptop', 'investment', 'other'
  title       String
  username    String?
  encryptedPassword String  // AES encrypted password
  url         String?
  notes       String?
  visibility  String   @default("family") // 'family' | 'adults' | 'private'
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
  @@index([familyId, category])
}

model Document {
  id          String   @id @default(cuid())
  userId      String   // creator ("added by")
  familyId    String?
  category    String   // 'investment', 'insurance', 'house', 'other'
  title       String
  description String?
  documentType String? // 'policy', 'deed', 'certificate', etc.

  // For policies and investments
  provider    String?
  policyNumber String?
  amount      Float?
  premium     Float?
  maturityDate DateTime?

  // File storage
  fileName    String?
  filePath    String?   // Encrypted file path
  fileSize    Int?
  mimeType    String?

  encryptedData String? // Additional encrypted metadata

  visibility  String   @default("family") // 'family' | 'adults' | 'private'

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, category])
  @@index([familyId, category])
}

model TrustedContact {
  id          String   @id @default(cuid())
  userId      String   // creator ("added by")
  familyId    String?
  contactName String
  contactEmail String
  relationship String  // 'spouse', 'child', 'lawyer', 'executor', etc.
  accessLevel String   // 'full', 'view-only', 'emergency-only'
  isActive    Boolean  @default(true)

  // Emergency access settings
  delayDays   Int      @default(7) // Days before access is granted
  recoveryCodeHash        String?   // sha256 of the one-time recovery code
  recoveryCodeGeneratedAt DateTime?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emergencyRequests EmergencyAccess[]

  @@index([userId])
  @@index([familyId])
  @@index([recoveryCodeHash])
}

model EmergencyAccess {
  id          String   @id @default(cuid())
  userId      String   // Vault owner
  familyId    String?
  contactId   String   // Trusted contact requesting access
  status      String   // 'pending', 'approved', 'denied', 'expired'
  requestedAt DateTime @default(now())
  approvedAt  DateTime?
  expiresAt   DateTime?
  deniedAt    DateTime?

  reason      String?
  accessTokenHash String? // sha256 of the read-only access token

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact     TrustedContact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([familyId, status])
  @@index([contactId])
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String
  familyId    String?
  action      String   // 'login', 'view_password', 'add_document', 'emergency_request', etc.
  entityType  String?  // 'password', 'document', 'trusted_contact', etc.
  entityId    String?
  ipAddress   String?
  userAgent   String?
  metadata    String?  // JSON string with additional data
  createdAt   DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([familyId, createdAt])
  @@index([action])
}
